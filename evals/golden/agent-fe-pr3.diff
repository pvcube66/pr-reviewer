+
+                      <td className="px-4 py-3 text-xs text-opbody">
+                        {fmtClock(c.call_duration_seconds)}
+                      </td>
+
+                      <td className="px-4 py-3 text-xs text-opbody">
+                        {c.cost_inr != null ? fmtINR(c.cost_inr) : "—"}
+                      </td>
+
+                      <td className="px-4 py-3 text-xs text-opmuted whitespace-nowrap">
+                        {fmtTime(c.created_at)}
+                      </td>
+
+                      <td className="max-w-[280px] px-4 py-3 text-[13px] text-opbody">
+                        <p className="truncate" title={c.call_summary || ""}>
+                          {c.call_summary || "No summary available."}
+                        </p>
+                      </td>
+                    </tr>
+                  );
+                })
+              )}
+            </tbody>
+          </DataTable>
+
+          <div className="mt-4">
+            <Pagination
+              showing={
+                filteredCalls.length > 0
+                  ? `Showing ${(page - 1) * rowsPerPage + 1}–${Math.min(page * rowsPerPage, filteredCalls.length)} of ${filteredCalls.length} calls`
+                  : "0 calls"
+              }
+              page={page}
+              totalPages={totalPages}
+              rowsPerPage={rowsPerPage}
+              onRowsPerPage={(n) => {
+                setRowsPerPage(n);
+                setPage(1);
+              }}
+              onPrev={() => setPage((p) => Math.max(1, p - 1))}
+              onNext={() => setPage((p) => Math.min(totalPages, p + 1))}
+            />
+          </div>
+        </div>
+      </div>
+
+      {/* Conversation Detail Drawer */}
+      {selectedCall && (
+        <ConversationDrawer
+          call={selectedCall}
+          onClose={() => setSelectedCall(null)}
+          onChanged={loadData}
+        />
+      )}
+    </div>
+  );
+}
