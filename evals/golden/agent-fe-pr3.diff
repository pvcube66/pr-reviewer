+  const [rowsPerPage, setRowsPerPage] = useState(10);
+
+  const loadData = async () => {
+    if (!id) return;
+    setLoading(true);
+    try {
+      const [sessionData, summaryData] = await Promise.all([
+        getBatchSessionById(id),
+        getBatchSummary(id),
+      ]);
