+        limit: "500",
+        page: "1",
+      });
+      if (campaignName && campaignName !== "Not Assigned") {
+        queryParams.set("campaign", campaignName);
+      }
+
+      const res = await axiosInstance.get(`/call-logs/specific-date/?${queryParams.toString()}`);
+      const rawCalls: ApiCallRecord[] = Array.isArray(res.data?.data) ? res.data.data : [];
+
+      // Filter calls belonging to this batch run
+      const batchPhones = new Set((sessionData?.phoneNumbers || []).map((p: string) => p.trim().replace(/\s+/g, "")));
+      const batchCreatedAt = sessionData?.createdAt ? new Date(sessionData.createdAt).getTime() : 0;
+
+      // 1. First check if any calls have batch_session_id or batch_id stamped
+      const idMatched = rawCalls.filter((c) => {
+        const item = c as unknown as Record<string, unknown>;
+        return item["batch_session_id"] === sessionData?._id || item["batch_id"] === sessionData?._id;
+      });
+
+      if (idMatched.length > 0) {
+        setCalls(idMatched);
+      } else if (batchPhones.size > 0) {
